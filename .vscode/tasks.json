{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/astsample.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary;ForceNoAlign"
			],
			"problemMatcher": "$msCompile",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "publish",
			"command": "dotnet",
			"type": "process",
			"args": [
				"publish",
				"${workspaceFolder}/astsample.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary;ForceNoAlign"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "watch",
			"command": "dotnet",
			"type": "process",
			"args": [
				"watch",
				"run",
				"--project",
				"${workspaceFolder}/astsample.csproj"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "generate helloworld java",
			"type": "shell",
			"command": "C:\\Program Files\\dotnet\\dotnet.exe",
			"args": [
				"run",
				"--no-build",
				"--project",
				"astsample.csproj",
				"--",
				"sourceFiles\\helloworldcs.aoi",
				"transcompiledFiles\\java\\helloworld\\Program.java_"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}