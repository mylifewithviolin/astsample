using System;

namespace Priority05DoWhile
{
    /// <summary>プログラム型</summary>
    public class Program
    {
        /// <summary>メイン</summary>
        /// <param name="args">引数</param>
        static void Main(string[] args)
        {
            int 値 = 1;
            do
            {
                Console.WriteLine("do-once");
                値++;
            } while (値 < 1);
        }
        
    }
}
